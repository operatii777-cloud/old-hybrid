{
  "compilerOptions": {
    "outDir":      "dist",
    "rootDir":     ".",
    "declaration": true,
    "module":      "CommonJS",
    "target":      "ES2022",
    "strict":      true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "index.ts"],
  "exclude": ["node_modules", "dist"]
}