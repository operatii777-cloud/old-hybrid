# OpenAI
OPENAI_API_KEY=sk-...

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/horeca

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2
CLOUDFLARE_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=horeca-media
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=https://media.yourhoreca.com

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=

# Cloudflare CDN (pentru cache purge)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Agregatori (opțional)
GLOVO_MENU_SYNC_URL=
BOLT_MENU_SYNC_URL=
WOLT_MENU_SYNC_URL=
TAZZ_MENU_SYNC_URL=

# Pricing configuration
VIP_PRICE_MULTIPLIER=1.25
