# AI Provider (groq = free tier, openai = paid)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...

# Set to 'true' to bypass AI API calls and use local regex parser (useful for CI/testing)
USE_MOCK_AI=false
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/horeca

# Redis
REDIS_URL=redis://localhost:6379

# Cloudflare R2
CLOUDFLARE_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=horeca-media
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_PUBLIC_URL=https://media.yourhoreca.com

# Meilisearch
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_KEY=

# Cloudflare CDN (pentru cache purge)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# Agregatori (opțional)
GLOVO_MENU_SYNC_URL=
BOLT_MENU_SYNC_URL=
WOLT_MENU_SYNC_URL=
TAZZ_MENU_SYNC_URL=

# Photo generation (set to 'true' to skip — required for Groq/free tier)
SKIP_PHOTOS=true

# Pricing configuration
VIP_PRICE_MULTIPLIER=1.25