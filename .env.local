# Local Development Environment
NODE_ENV=local
PORT=3000
DATABASE_URL=./data/restaurant.db
FRONTEND_BUILD=dist
CLOUD_ENABLED=false

# Email - Leave empty if not using
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS - Leave empty if not using
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# JWT
JWT_SECRET=local-dev-secret-key
JWT_EXPIRES_IN=7d

# Restaurant Info
RESTAURANT_NAME="Restaurant Hybrid"
RESTAURANT_ADDRESS="Str. Exemplu Nr. 1"
RESTAURANT_CITY="București"
RESTAURANT_PHONE="+40 21 123 4567"
RESTAURANT_CUI="RO12345678"

# Weather API (Open-Meteo is primary — free, no key needed)
# Optional OWM fallback
WEATHER_API_KEY=
WEATHER_DEFAULT_LAT=44.4268
WEATHER_DEFAULT_LON=26.1025

# AI Assistant (all free engines — configure at least one)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
AI_PROVIDER=auto
