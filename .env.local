# Local Development Environment
NODE_ENV=local
PORT=3000
DATABASE_URL=./data/restaurant.db
FRONTEND_BUILD=dist
CLOUD_ENABLED=false

# Email - Leave empty if not using
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS - Leave empty if not using
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# JWT
JWT_SECRET=local-dev-secret-key
JWT_EXPIRES_IN=7d

# Restaurant Info
RESTAURANT_NAME="Restaurant Hybrid"
RESTAURANT_ADDRESS="Str. Exemplu Nr. 1"
RESTAURANT_CITY="București"
RESTAURANT_PHONE="+40 21 123 4567"
RESTAURANT_CUI="RO12345678"
