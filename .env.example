# =============================================================================
# RESTAURANT HYBRID - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.local and update with your actual values
# Note: This application supports both local and cloud deployment modes
# =============================================================================

# -----------------------------------------------------------------------------
# NODE ENVIRONMENT
# -----------------------------------------------------------------------------
# Options: local, development, production
# Use 'local' for POS-only mode, 'production' for cloud-enabled mode
NODE_ENV=local

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=3001

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Options: error, warn, info, http, debug
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Path to SQLite database file (relative to project root)
DATABASE_URL=./data/restaurant.db
# Alternative name for the same setting (takes precedence if set)
SQLITE_PATH=./data/restaurant.db

# -----------------------------------------------------------------------------
# FRONTEND BUILD CONFIGURATION
# -----------------------------------------------------------------------------
# Directory where frontend build artifacts are located (relative to project root)
FRONTEND_BUILD=dist

# -----------------------------------------------------------------------------
# CLOUD/SYNC CONFIGURATION
# -----------------------------------------------------------------------------
# Enable cloud synchronization and backup features
# Set to 'true' to enable cloud features, 'false' for local-only mode
CLOUD_ENABLED=false

# -----------------------------------------------------------------------------
# EMAIL NOTIFICATION CONFIGURATION (Nodemailer)
# -----------------------------------------------------------------------------
# Required for sending email notifications (reservations, orders, alerts)
# To use Gmail, you need to create an "App Password" from your Google Account:
# 1. Go to Google Account > Security > 2-Step Verification > App passwords
# 2. Generate a new app password for "Mail"
# 3. Use that password below (not your regular Gmail password)
#
# For other email providers, adjust SMTP_HOST and SMTP_PORT accordingly

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Restaurant Hybrid <noreply@restaurant.com>"

# -----------------------------------------------------------------------------
# SMS NOTIFICATION CONFIGURATION (Twilio)
# -----------------------------------------------------------------------------
# Required for sending SMS notifications (reservations, order updates)
# To get Twilio credentials:
# 1. Sign up at https://www.twilio.com/
# 2. Get your Account SID and Auth Token from the Twilio Console
# 3. Purchase a phone number or use a trial number
# 4. Replace the values below with your actual Twilio credentials

TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# WEATHER API CONFIGURATION
# -----------------------------------------------------------------------------
# Primary (FREE, no key required): Open-Meteo — https://open-meteo.com
#   100% free, commercial and non-commercial use. No registration needed.
#   The system uses Open-Meteo automatically, zero configuration required.
#
# Optional fallback: OpenWeatherMap — https://openweathermap.org/api
#   Free tier: 1,000 calls/day. Set WEATHER_API_KEY to enable OWM fallback.
#   Used only if Open-Meteo is temporarily unavailable.
#
WEATHER_API_KEY=
# Default restaurant location (lat/lon used for weather data)
WEATHER_DEFAULT_LAT=44.4268
WEATHER_DEFAULT_LON=26.1025

# -----------------------------------------------------------------------------
# AI ASSISTANT CONFIGURATION (all engines are FREE)
# -----------------------------------------------------------------------------
# The AI Assistant module supports multiple free AI engines.
# Configure at least one for real AI responses (otherwise demo mode is used).
# Priority order: Ollama → Groq → Gemini → OpenRouter → HuggingFace
#
# --- Option 1: Ollama (LOCAL, 100% FREE, no internet needed) ---
# Install: https://ollama.ai  |  Then: ollama pull llama3
# No key required. Default URL: http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
#
# --- Option 2: Groq (FREE TIER — 30 req/min, 14400 req/day, 500K tokens/day) ---
# Register: https://console.groq.com  |  Free, no credit card needed
GROQ_API_KEY=
#
# --- Option 3: Google Gemini (FREE TIER — 15 RPM, 1M tokens/day for Flash) ---
# Register: https://aistudio.google.com  |  Free API key
GEMINI_API_KEY=
#
# --- Option 4: OpenRouter (FREE models: Gemma 2, Llama 3.1, Mistral etc.) ---
# Register: https://openrouter.ai  |  Free models available without billing
OPENROUTER_API_KEY=
#
# --- Option 5: HuggingFace Inference (FREE for public models) ---
# Register: https://huggingface.co/settings/tokens  |  Free token
HUGGINGFACE_API_KEY=
#
# Active provider (auto = tries each in priority order)
# Options: auto | ollama | groq | gemini | openrouter | huggingface
AI_PROVIDER=auto


# -----------------------------------------------------------------------------
# Used for future authentication enhancements
# Generate a strong random secret for production:
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# RESTAURANT INFORMATION
# -----------------------------------------------------------------------------
# Used for invoice generation and email/SMS signatures
# Update these with your actual restaurant details

RESTAURANT_NAME="Restaurant Hybrid"
RESTAURANT_ADDRESS="Str. Exemplu Nr. 1"
RESTAURANT_CITY="București"
RESTAURANT_PHONE="+40 21 123 4567"
RESTAURANT_CUI="RO12345678"

# =============================================================================
# TESTING NOTIFICATION SERVICES
# =============================================================================
# To test email notifications:
# 1. Update SMTP_USER with your email (e.g., yourname@gmail.com)
# 2. Update SMTP_PASS with your app password (for Gmail) or SMTP password
# 3. Run: npm test
# 4. Check the test output for email configuration status
#
# To test SMS notifications:
# 1. Sign up for a Twilio account (free trial available)
# 2. Update TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_PHONE_NUMBER
# 3. Run: npm test
# 4. Check the test output for SMS configuration status
#
# Note: Both services will work in "graceful degradation" mode if not configured
# The application will log warnings but continue to function without sending notifications
# =============================================================================

