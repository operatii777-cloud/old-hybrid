# Node Environment
NODE_ENV=local

# Server Configuration
PORT=3000

# Database
DATABASE_URL=./data/restaurant.db

# Frontend Build Directory (relative to project root)
FRONTEND_BUILD=dist

# Cloud/Sync Configuration
CLOUD_ENABLED=false

# Email Configuration (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Restaurant Hybrid <noreply@restaurant.com>"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# JWT Configuration (for future authentication enhancement)
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Restaurant Info (for invoices)
RESTAURANT_NAME="Restaurant Hybrid"
RESTAURANT_ADDRESS="Str. Exemplu Nr. 1"
RESTAURANT_CITY="București"
RESTAURANT_PHONE="+40 21 123 4567"
RESTAURANT_CUI="RO12345678"
